<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SDK-style project (converted 2026-08-08 from the old packages.config format).

    Why: the previous format needed Visual Studio / MSBuild 15+ AND the .NET Framework 4.7.2
    Developer Pack installed just to produce a package, which meant a release could only be cut on
    one machine. With the SDK format plus Microsoft.NETFramework.ReferenceAssemblies below, the
    .NET SDK alone can build and pack this on any machine - `dotnet pack -c Release`.

    The package metadata lives here too, so the version is in ONE place. There is no longer a
    separate .nuspec or AssemblyInfo version to keep in step.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>StocksDeveloper.AutoTraderWeb.Api</AssemblyName>
    <RootNamespace>com.dakshata</RootNamespace>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- NuGet package metadata (was csharp-library.nuspec) -->
  <PropertyGroup>
    <PackageId>StocksDeveloper.AutoTraderWeb.Api</PackageId>
    <Version>1.5.0</Version>
    <Title>StocksDeveloper Broker Independent Automated Trading C# API</Title>
    <Authors>Pritesh Mhatre</Authors>
    <Company>Stocks Developer</Company>
    <Product>AutoTrader Web</Product>
    <Description>C# trading API library for Zerodha, Upstox, AliceBlue, Finvasia, Angel One, Fyers, IIFL, 5Paisa, Profitmart, Mastertrust, Edelweiss, Motilal Oswal, Kotak Securities</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://stocksdeveloper.in/documentation/client-setup/c-library/</PackageProjectUrl>
    <PackageTags>C# trading API library for Zerodha Upstox AliceBlue Finvasia AngelOne Fyers IIFL 5Paisa Profitmart Mastertrust Edelweiss Motilal Oswal KotakSecurities</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/stocks-developer/autotrader-csharp-lib</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright © Stocks Developer</Copyright>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>Adds the account management APIs: FetchAllTradingAccounts, CreateTradingAccount, UpdateTradingAccount, ValidateCredentials, ValidateAccount and ValidateAllAccounts. ValidateAccount and ValidateAllAccounts are useful before the market opens, to find accounts whose broker credentials have expired.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="4.7.2" />
    <!--
      Lets the .NET SDK build a .NET Framework target WITHOUT the Developer Pack / reference
      assemblies being installed on the machine. PrivateAssets="all" keeps it a build-time only
      dependency, so it never appears in the published package's dependency list.
    -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Not in the SDK's default .NET Framework reference set; HttpUtility comes from here. -->
    <Reference Include="System.Web" />
  </ItemGroup>

</Project>
